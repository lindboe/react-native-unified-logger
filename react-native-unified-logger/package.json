{
  "name": "react-native-unified-logger",
  "version": "0.1.0",
  "description": "Log the same way from JavaScript, iOS (Objective-C/Swift), and Android (Kotlin/Java) in React Native, with platform-native output and an optional JS callback for remote logging.",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json",
    "./jest/mock": "./jest/mock.js"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "*.podspec",
    "jest",
    "README.md",
    "LICENSE",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "clean": "rm -rf lib",
    "prepare": "bob build"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "logging",
    "logger",
    "os_log",
    "logcat",
    "turbomodule"
  ],
  "license": "MIT",
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.88.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "jest": "^29.7.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-builder-bob": "^0.44.1",
    "typescript": "^6.0.3",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/jest-preset": "0.88.1"
  },
  "codegenConfig": {
    "name": "RNUnifiedLoggerSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.unifiedlogger"
    },
    "ios": {
      "modulesProvider": {
        "UnifiedLogger": "RNUnifiedLoggerModule"
      }
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "homepage": "https://github.com/lindboe/react-native-unified-logger#readme",
  "author": "Lizzi Lindboe",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lindboe/react-native-unified-logger.git"
  },
  "bugs": {
    "url": "https://github.com/lindboe/react-native-unified-logger/issues"
  }
}
